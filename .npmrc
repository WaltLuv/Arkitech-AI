# @composio/openai-agents declares a peer of @openai/agents@^0.1.3 on every
# published version, including the latest. This project runs @openai/agents
# 0.17.x. The constraint is stale metadata rather than a real incompatibility:
# the provider imports only `tool` from the SDK, and tools it wraps are
# accepted by Agent on 0.17 (covered by lib/composio.test.ts).
#
# Without this, `npm install` and `npm ci` both fail on a clean checkout.
legacy-peer-deps=true
