# App Setup
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Neon Serverless Postgres Database (Drizzle ORM)
DATABASE_URL=postgresql://neondb_owner:your_password@ep-placeholder-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication (SaaS Hosted Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_ZXhhbXBsZS5jbGVyay5hY2NvdW50cy5kZXYk
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Google Gemini - used to generate structured agent configurations
GOOGLE_CLOUD_GEMINI_API_KEY=your_gemini_api_key

# OpenAI Agents SDK - used to run generated agents
OPENAI_API_KEY=sk-your_openai_api_key
OPENAI_MODEL=gpt-4.1-mini

# Composio - used for external app/toolkit connections
COMPOSIO_API_KEY=your_composio_api_key

# Browserbase - Arkitech's cloud browser provider.
# Required for session-based browser execution.
BROWSERBASE_API_KEY=your_browserbase_api_key
BROWSERBASE_PROJECT_ID=your_browserbase_project_id
# Used only by the existing hosted-agent research tool (lib/browserbase-tool.ts).
# Session-based execution does not read it.
BROWSERBASE_AGENT_ID=your_browserbase_agent_id
# Maximum concurrent browser sessions Arkitech will hold. Defaults to 1.
BROWSER_SLOT_LIMIT=1

# Inngest - required in production; optional when using `npx inngest-cli@latest dev`
INNGEST_EVENT_KEY=your_inngest_event_key
INNGEST_SIGNING_KEY=your_inngest_signing_key
# How long one browser run may hold a session before it is stopped and the
# session released. Default 20 minutes.
BROWSER_MAX_RUN_MS=1200000
# How long a provider session may live before the cleanup sweep releases it.
# Default 30 minutes.
BROWSER_MAX_SESSION_MS=1800000
# How many times a run may be claimed before Arkitech gives up on it. Every
# attempt opens a paid browser, so this is bounded. Default 3.
BROWSER_MAX_ATTEMPTS=3

# Communication channels (Telegram, Slack).
#
# Seals the credentials a channel connection stores, with AES-256-GCM. Any 32
# random bytes, base64 or hex:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Changing it makes every stored connection unreadable and they must be
# reconnected, so treat it like a database password.
CHANNEL_SECRET_KEY=

# Slack. One Arkitech Slack app serves every customer; each workspace installs
# it through OAuth and gets its own bot token, stored sealed per connection.
# The signing secret belongs to the app and verifies every inbound event.
# Telegram needs none of these: a customer brings their own bot token.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_SIGNING_SECRET=

# Live provider verification (lib/browserbase/live.test.ts) is skipped unless
# this is set. It creates one real, billable Browserbase session and releases
# it afterwards:
#   set -a && . ./.env.local && set +a
#   LIVE_BROWSERBASE=1 npx vitest run lib/browserbase/live.test.ts
LIVE_BROWSERBASE=
